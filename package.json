{
  "name": "yall-rtmp-docker-stream",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "check:spec-sync": "bun scripts/check-spec-sync.ts",
    "lint": "biome check src/ scripts/ tests/",
    "lint:fix": "biome check --write --unsafe src/ scripts/ tests/",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit/",
    "test:integration": "bun test tests/integration/",
    "dev": "bun --watch --env-file=.env run src/index.ts",
    "build": "bun build ./src/index.ts --compile --outfile dist/sidecar",
    "start": "./dist/sidecar"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.9.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/jsonwebtoken": "^9.0.7",
    "bun-types": "^1.2.11",
    "typescript": "^5.7.2"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
