# Bootstrap config only — ConfigService validates these at startup and fails
# fast if any are missing. Destination/ingest stream keys are NOT here; they
# live in Mongo, per-user, set through the app itself (see docs/TECHNICAL.md
# §Persistence & auth).
#
# MONGO_URI points at localhost:27117 (docker-compose.yml's host-mapped
# port), not mongo:27017 — the sidecar runs on the host via `bun run dev`,
# not inside docker-compose, since there's no `relay` service/Dockerfile
# yet. Change this if that changes.

MONGO_URI=mongodb://localhost:27117/yallcast-dev
JWT_SECRET=
# 64 hex chars (32 bytes) for AES-256-GCM, encrypting destination stream
# keys at rest — generate with: openssl rand -hex 32
# A different key from JWT_SECRET on purpose — signing and at-rest
# encryption are different cryptographic purposes; see infra/crypto.ts.
ENCRYPTION_KEY=
HTTP_PORT=8080
# Host IP for RTMP endpoint (passed to container)
# Leave blank to use host.docker.internal (Mac/Windows Docker Desktop)
# Set to your actual machine IP if on Linux or behind a network (e.g., 192.168.x.x)
HOST_IP=
RTMP_PORT=1935
