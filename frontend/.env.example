# Frontend environment configuration
# Copy to .env.local for local development, or set via CI/deployment

# API base URL for all backend calls
# Local development: http://localhost:8080
# Network access (mobile/external): http://192.168.188.29:8080
# Production: https://api.yourdomain.com
VITE_API_BASE=http://localhost:8080

# Optional: RTMP relay URL for display purposes
VITE_RTMP_RELAY_URL=rtmp://192.168.188.29:1935
