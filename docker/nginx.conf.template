# nginx-rtmp config template — docs/TECHNICAL.md §RTMP relay. Rendered by
# NginxConfigRenderer via `envsubst`, not hand-edited in the running
# container. Exactly seven placeholders, deliberately — see the regression
# test planned in docs/TECHNICAL.md §Testing strategy ("assert that
# rendering never touches nginx's own $name variable in the template, only
# the explicit placeholder names"): ${HTTP_PORT}, ${MIXCLOUD_PUSH_LINE},
# ${YOUTUBE_PUSH_LINE}, ${TWITCH_PUSH_LINE} (the original four), plus
# ${OUT_QUEUE}/${OUT_CORK}/${RELAY_BUFFER_MS} added for the per-user
# bufferProfile (mobile/stable) preset — see §Per-user buffer profile. A
# disabled/unconfigured destination renders its push-line placeholder as an
# empty string, not a push line pointed at nothing — NginxConfigRenderer
# decides that, this template just drops whatever it's given in place.
#
# Ingest auth is NOT done here, on purpose: there is no per-user key check
# in this file at all. nginx-rtmp's `on_publish` calls the sidecar with the
# stream key as a form field; the sidecar (IngestEventReceiver) is what
# accepts or rejects it against the active profile's ingestStreamKey. This
# file only ever has one static `ingest` application because only one
# profile is ever active at a time — see §RTMP relay.

worker_processes auto;
# A real file, not /dev/stderr — found the hard way (build order step 4's
# own end-to-end container test, not a guess): NginxProcessManager spawns
# nginx with its stderr as a Node pipe (`stdio: ["ignore", "pipe",
# "pipe"]`), not an inherited fd, and nginx opening `/dev/stderr` then
# resolves through `/proc/self/fd/2` to that pipe — which fails at open()
# with ENXIO ("No such device or address"), a known Linux quirk for
# reopening a pipe by its /proc/self/fd path. `docker build`'s own
# `nginx -t` self-test never caught this: BuildKit's RUN steps give `-t`
# a real inherited stderr, not a pipe, so the failure mode only shows up
# once NginxProcessManager actually spawns the process at runtime. Early
# fatal startup errors (like this one was) still reach the sidecar's logs
# regardless of this path — nginx writes those to its own process stderr
# before it's even parsed `error_log`, which Node's piped `child.stderr`
# always captures.
error_log /usr/local/nginx/logs/error.log warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

rtmp {
    server {
        listen 1935;
        chunk_size 4096;

        # Buffering & backpressure — docs/TECHNICAL.md §RTMP relay. Per-user
        # bufferProfile ('mobile'/'stable') also rendered in by
        # NginxConfigRenderer as these same three values change per
        # activation; the template itself doesn't know about presets, only
        # the resulting directive values. All three are server-level, not
        # application-level, directives — confirmed the hard way: an
        # earlier version of this template put relay_buffer inside
        # `application ingest {}` and nginx's own `-t` rejected it at
        # image-build time ("relay_buffer" directive is not allowed here)
        # before this was ever trusted. out_queue/out_cork were correctly
        # placed from the start by checking ngx_rtmp_core_module.c's own
        # NGX_RTMP_SRV_CONF flag before writing this, not guessed.
        out_queue ${OUT_QUEUE};
        out_cork ${OUT_CORK};
        relay_buffer ${RELAY_BUFFER_MS};

        application ingest {
            live on;
            record off;
            wait_key on;

            on_publish http://127.0.0.1:${HTTP_PORT}/internal/nginx/on-publish;
            on_publish_done http://127.0.0.1:${HTTP_PORT}/internal/nginx/on-publish-done;

            ${MIXCLOUD_PUSH_LINE}
            ${YOUTUBE_PUSH_LINE}
            ${TWITCH_PUSH_LINE}
        }
    }
}

# Minimal HTTP block — nginx's core requires at least one http{} server to
# build/run with the default modules; also where the Open Questions'
# "per-destination push status via /stat" would read from, if that question
# resolves toward needing it. Loopback-only, not part of the sidecar's own
# :8080.
http {
    server {
        listen 127.0.0.1:8090;
        location /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }
    }
}
